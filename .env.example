# Dots Fam settings. Copy to .env in the folder you run `dotsfam` from.

# ---- Server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8787
# Required whenever HOST is not localhost. Long and random: python -c "import secrets; print(secrets.token_urlsafe(32))"
OWNER_TOKEN=
# The address people and webhooks reach this server at (used in webhook URLs).
PUBLIC_URL=
DEFAULT_TIMEZONE=Asia/Kolkata
DATA_DIR=data

# ---- Models (at least one provider) ------------------------------------------
# Dots name models as provider:model. Set the keys for the providers you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# The Chief of Staff and new Dots use DEFAULT_MODEL; specialists start on WORKER_MODEL.
DEFAULT_MODEL=anthropic:claude-sonnet-4-5
WORKER_MODEL=openai:gpt-5-mini
# Examples: openrouter:deepseek/deepseek-chat-v3.1, openai:gpt-5, anthropic:claude-haiku-4-5

# ---- Web search for every Dot (recommended) -------------------------------------
# With an Exa key (exa.ai), Dots search the web, read and crawl pages, and get cited answers
# whenever a question needs current facts. Without it they can only read pages by URL.
EXA_API_KEY=
# Safety cap on searches/reads per task, so a confused Dot can't loop up a bill.
EXA_MAX_CALLS_PER_RUN=30

# ---- Limits -----------------------------------------------------------------
RUNNER_CONCURRENCY=3
TASK_TIMEOUT_SECONDS=600
MAX_DELEGATED_WORKERS=4
WORKER_TIMEOUT_SECONDS=300

# ---- A computer per Dot (optional) -----------------------------------------------
# none | docker (recommended: one container per Dot) | local (development only)
COMPUTER_DRIVER=none
COMPUTER_IMAGE=dotsfam-computer:latest
# Optional: fixes the per-Dot computer tokens across restarts.
COMPUTER_TOKEN=

# ---- Slack (optional, Socket Mode: no public URL needed) --------------------------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Comma-separated Slack member IDs allowed to talk to and approve for your team.
SLACK_ALLOWED_USERS=
# Which Dot answers mentions by default (the Chief of Staff when empty).
SLACK_DOT=
# Channel ID for approvals and routine results from conversations that did not start in Slack.
SLACK_NOTIFY_CHANNEL=

# ---- Voice calls (optional) -------------------------------------------------------
# local = Whisper + Kokoro on this machine (open models) | openai | off
VOICE_STACK=local
VOICE_LANGUAGE=en
# large-v3-turbo (best), small or base (faster on modest CPUs), or any faster-whisper model name
VOICE_WHISPER_MODEL=large-v3-turbo
VOICE_WHISPER_DEVICE=auto
VOICE_KOKORO_VOICE=af_heart
VOICE_OPENAI_STT_MODEL=gpt-4o-transcribe
VOICE_OPENAI_TTS_MODEL=gpt-4o-mini-tts
VOICE_OPENAI_VOICE=alloy
# STUN/TURN servers for calls across networks (comma-separated). Empty works on localhost and LANs.
VOICE_ICE_SERVERS=stun:stun.l.google.com:19302
