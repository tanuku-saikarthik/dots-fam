# OpenDots template: the UI opens in setup state until these fields are configured.
HOST=127.0.0.1
PORT=4420
DATABASE_PATH=data/opendots.sqlite
# Keep OWNER_ID stable: it owns the persistent Intelligence conversations.
OWNER_ID=opendots-owner
# npm run dev allows http://127.0.0.1:5273; override for a different exact origin.
# APP_ORIGIN=http://127.0.0.1:5273
# Required for an external HOST binding (24+ characters); enables local login too.
# OWNER_TOKEN=

INTELLIGENCE_API_KEY=
# INTELLIGENCE_API_URL=
# INTELLIGENCE_WS_URL=

# Models: configure one or more providers. Dots use provider:model names.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Legacy default (no prefix). DEFAULT_MODEL takes precedence when set.
OPENAI_MODEL=
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# e.g. anthropic:claude-sonnet-4-5, openai:gpt-5.2, openrouter:anthropic/claude-sonnet-4.5
DEFAULT_MODEL=
# Suggested for specialist Dots when installing the team, e.g. openai:gpt-5-mini
WORKER_MODEL=

# Team: routines, delegation, and webhooks. See docs/TEAM.md.
DEFAULT_TIMEZONE=UTC
# Public base URL shown for webhook triggers (deployed or tunneled HTTPS origin).
# PUBLIC_URL=https://dots.example.com
# RUNNER_CONCURRENCY=2
# TASK_TIMEOUT_SECONDS=420
# MAX_DELEGATED_WORKERS=4
# WORKER_TIMEOUT_SECONDS=300
# COPILOTKIT_TELEMETRY_DISABLED=true

# Open-ended web search for Dots and the research runner, via Tavily (app.tavily.com).
TAVILY_API_KEY=
# Fallback JS-rendering, redirect-following page reader for sites the local browser can't reach
# (Meetup, Luma, etc). Get a key at dashboard.exa.ai ($10 free credits on signup).
EXA_API_KEY=

# Optional isolated read-only public-page browser. No search service is bundled.
BROWSER_URL=http://127.0.0.1:4311
BROWSER_SECRET=
BROWSER_HOST=127.0.0.1
BROWSER_PORT=4311
# Use the same random 24+ character secret in app/browser. All redirects are blocked.
# Supply canonical public URLs. Use the separate browser container for isolation.

# Optional realtime speech; compute uses the same configured Intelligence thread.
VOICE_API_KEY=
VOICE_MODEL=
VOICE_NAME=marin

# Optional managed Slack channel; see docs/SETUP.md#slack.
# Match the managed declaration name, not a Slack #conversation name.
# OpenTag calls this INTELLIGENCE_CHANNEL_NAME; OpenDots uses SLACK_CHANNEL_NAME.
# Allowlist both the Slack workspace and explicit Slack user IDs.
SLACK_CHANNEL_NAME=
SLACK_TEAM_ID=
SLACK_USER_IDS=
# SLACK_DOT_ID= (defaults to the initial Dot)

# Optional persistent computers, one per Dot, using OpenBot services.
# See docs/COMPUTERS.md. Keep these two different random secrets on the server.
COMPUTER_SUPERVISOR_URL=
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
# Keep stable: the namespace identifies existing containers and persistent volumes.
COMPUTER_NAMESPACE=opendots
# COMPUTER_MEMORY_BYTES=2147483648
# COMPUTER_RUNTIME=runsc
# ENGINE_SOCKET=/var/run/docker.sock
